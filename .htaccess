Options -Indexes
RewriteEngine On

# Izinkan akses langsung ke file & folder yang ada (css, js, gambar, dll.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Semua request lain → index.php (kompatibel untuk folder apapun seperti aplikasi-simulasi atau Aplikasi-Simulasi-main1)
RewriteRule ^ index.php [L,QSA]
